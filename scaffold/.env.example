# Local SQLite file, auto-created and auto-migrated on first run.
DATABASE_PATH=data/clearmatch.db

# anthropic | openai | ollama — run `npm run setup` (cloud key) or
# `npm run setup:local` (fully local via Ollama) to fill this in automatically,
# or set it by hand.
LLM_PROVIDER=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Only used when LLM_PROVIDER=ollama — set by `npm run setup:local`
# (e.g. http://localhost:11434/v1).
LLM_BASE_URL=
# Only used when LLM_PROVIDER=ollama, e.g. qwen2.5:7b.
LOCAL_LLM_MODEL=

# openai | ollama — independent of LLM_PROVIDER, since Anthropic has no
# embeddings API. Filled in by `npm run setup`/`setup:local` alongside the
# chat provider above.
EMBEDDINGS_PROVIDER=
# e.g. text-embedding-3-small (openai) or nomic-embed-text (ollama)
EMBEDDINGS_MODEL=
# Only used when EMBEDDINGS_PROVIDER=ollama.
EMBEDDINGS_BASE_URL=
