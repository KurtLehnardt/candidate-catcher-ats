DATABASE_PATH=data/clearmatch.db  # local SQLite file, auto-created and auto-migrated on first run
LLM_PROVIDER=anthropic            # anthropic | openai | ollama
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
LLM_BASE_URL=                     # set for ollama: http://localhost:11434/v1
LOCAL_LLM_MODEL=                  # set for ollama, e.g. qwen2.5:7b
EMBEDDINGS_PROVIDER=openai        # openai | ollama
EMBEDDINGS_MODEL=text-embedding-3-small   # or nomic-embed-text for ollama
EMBEDDINGS_BASE_URL=
